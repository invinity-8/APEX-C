# ---------------------------------------------------------------------------
# APEX 0.2 – environment variables
# Copy to .env.local for local development. NEVER commit real secrets.
# ---------------------------------------------------------------------------

# --- Browser (public, bundled into the client) ------------------------------
# Supabase project URL
VITE_SUPABASE_URL=https://xqkyaqxuoaxadpkcdhch.supabase.co
# Publishable key (sb_publishable_…) or legacy anon key. Safe in the browser; protected by RLS.
VITE_SUPABASE_PUBLISHABLE_KEY=
# Optional: "true" keeps the local demo reachable via /?demo when online mode is on.
VITE_APEX_ALLOW_DEMO=false
# Optional: "true" shows "Create an account" on the login page (invite-only access still applies).
VITE_APEX_ALLOW_SIGNUP=false

# --- Server only (Vercel Function /api/apex) --------------------------------
# NEVER prefix these with VITE_ – they must not reach the browser.
SUPABASE_URL=https://xqkyaqxuoaxadpkcdhch.supabase.co
# Secret key (sb_secret_…) or legacy service_role key. Bypasses RLS – server only!
SUPABASE_SECRET_KEY=
